#!/bin/sh
# Refuses a commit that adds a merge-conflict marker line (<<<<<<< or >>>>>>>) and says which file.
# On once per clone: git config core.hooksPath tools/hooks
bad=$(git diff --cached -U0 | awk '/^\+\+\+ /{f=substr($0,7)} /^\+(<<<<<<<|>>>>>>>)/{print f}' | sort -u)
if [ -n "$bad" ]; then
  echo "commit refused: conflict marker (<<<<<<< or >>>>>>>) in staged file(s):" >&2
  echo "$bad" >&2
  exit 1
fi

# The loop only prints; the refusal is decided below in the main shell, not inside the pipe.
mixed=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR | while IFS= read -r file; do
  if git diff --cached --numstat -- "$file" | awk '$1 == "-" && $2 == "-" { binary=1 } END { exit !binary }'; then
    continue
  fi
  # BINMODE preserves CR on Windows; the sentinel excludes an unterminated last line.
  first=$( { git show ":$file"; printf '.'; } | awk -v BINMODE=3 '
    NR > 1 {
      if (line ~ /\r$/) crlf=1
      else if (!lf) lf=NR-1
    }
    { line=$0 }
    END { if (crlf && lf) print lf }
  ')
  if [ -n "$first" ]; then
    echo "commit refused: mixed line endings in $file (first LF-only line $first)"
  fi
done)
if [ -n "$mixed" ]; then
  echo "$mixed" >&2
  exit 1
fi
