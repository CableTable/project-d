{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core, closing the window after the unsaved-changes prompt, Open/Save dialogs, and read/write of files the user picks. fs scope: home, Desktop, Documents, Downloads, and any drive letter (A-Z:/**). Dialog-picked paths are also added to the scope at runtime.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "fs:allow-read-text-file",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "C:/Windows/Fonts/*.ttf" }]
    },
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "?:/**" },
        { "path": "?:\\**" }
      ]
    }
  ]
}
