{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectD",
  "mainBinaryName": "ProjectD",
  "version": "0.1.0",
  "identifier": "com.rakshith.projectd",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Project D",
        "dragDropEnabled": false,
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
